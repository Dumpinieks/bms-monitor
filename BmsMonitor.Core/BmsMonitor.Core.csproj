<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Windows target needs the Windows reference packs, which only resolve on Windows unless
    EnableWindowsTargeting is set. So it is in the default set on Windows only; cross-build it
    from Linux with: dotnet build -p:EnableWindowsTargeting=true
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT' or '$(EnableWindowsTargeting)' == 'true'">net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BmsMonitor</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <IsWindowsTarget>$([MSBuild]::ValueOrDefault($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')), '').Equals('windows'))</IsWindowsTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsWindowsTarget)' == 'true'">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Each platform's Bluetooth stack and notifier live in a Windows/ or Linux/ folder. -->
  <ItemGroup Condition="'$(IsWindowsTarget)' == 'true'">
    <Compile Remove="**\Linux\**\*.cs" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- Overrides the vulnerable 4.7.0 pulled in transitively by the toolkit -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsWindowsTarget)' != 'true'">
    <Compile Remove="**\Windows\**\*.cs" />
    <PackageReference Include="Tmds.DBus" Version="0.95.1" />
  </ItemGroup>

</Project>
